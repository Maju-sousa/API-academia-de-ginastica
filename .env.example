NODE_ENV=development
PORT=3000
LOG_LEVEL=info

POSTGRES_USER=starlife
POSTGRES_PASSWORD=starlife
POSTGRES_DB=starlife
DATABASE_URL=postgresql://starlife:starlife@localhost:5432/starlife?schema=public

REDIS_URL=redis://localhost:6379
CACHE_DEFAULT_TTL=60

# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-random-value-at-least-32-chars
JWT_EXPIRES_IN=15m

BCRYPT_ROUNDS=12
CORS_ORIGIN=*

# dev only
SEED_ADMIN_EMAIL=admin@starlife.dev
SEED_ADMIN_PASSWORD=starlife-admin-123
SEED_TRAINER_EMAIL=trainer@starlife.dev
SEED_TRAINER_PASSWORD=starlife-trainer-123
SEED_MEMBER_EMAIL=member@starlife.dev
SEED_MEMBER_PASSWORD=starlife-member-123
